rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    match /usernames/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
    }
    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'text', 'mediaType',
          'mediaURL', 'musicURL', 'musicName', 'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.text is string
        && request.resource.data.mediaType in ['text', 'image', 'video', 'music']
        && request.resource.data.mediaURL is string
        && request.resource.data.musicURL is string
        && request.resource.data.musicName is string
        && request.resource.data.createdAt is int;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'mediaURL', 'mediaType',
          'createdAt', 'expiresAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.mediaURL is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.resource.data.createdAt;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /chats/{c} {
      allow read, update: if request.auth.uid in resource.data.members;
      allow create: if request.auth.uid in request.resource.data.members;
      match /messages/{m} {
        allow read: if request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members;
        allow create: if request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members
                      && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
