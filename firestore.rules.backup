rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    match /usernames/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
    }
    match /chats/{c} {
      allow read, update: if request.auth.uid in resource.data.members;
      allow create: if request.auth.uid in request.resource.data.members;
      match /messages/{m} {
        allow read: if request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members;
        allow create: if request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.members
                      && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
